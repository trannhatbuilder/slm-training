          "table_number": null,
          "style": "EvvoH2",
          "text": "Root Detection Not Implemented",
          "rows": null
        },
        {
          "block_number": 286,
          "block_type": "table",
          "paragraph_number": null,
          "table_number": 22,
          "style": null,
          "text": null,
          "rows": [
            {
              "row_number": 1,
              "cells": [
                "SEVERITY",
                "LOW"
              ]
            },
            {
              "row_number": 2,
              "cells": [
                "AFFECTED TARGETS",
