    {
      "finding_id": "FND-000004",
      "document_id": "DOC-000001",
      "title": "Weak SSL Pinning Implementation",
      "source_title_block": {
        "block_number": 305,
        "paragraph_number": 283,
        "style": "EvvoH2"
      },
      "extraction": {
        "start_block_number": 305,
        "end_block_number": 330,
        "block_count": 26,
        "non_empty_block_count": 17
      },
      "raw_blocks": [
        {
          "block_number": 305,
          "block_type": "paragraph",
          "paragraph_number": 283,
          "table_number": null,
          "style": "EvvoH2",
          "text": "Weak SSL Pinning Implementation",
          "rows": null
        },
        {
          "block_number": 306,
          "block_type": "table",
          "paragraph_number": null,
          "table_number": 23,
          "style": null,
          "text": null,
          "rows": [
            {
              "row_number": 1,
              "cells": [
                "SEVERITY",
                "LOW"
              ]
            },
            {
              "row_number": 2,
              "cells": [
                "AFFECTED TARGETS",
                "Android Mobile Application"
              ]
            },
            {
              "row_number": 3,
              "cells": [
                "CWE-ID",
                "CWE-295: Improper Certificate Validation"
              ]
            },
            {
              "row_number": 4,
              "cells": [
                "IMPACT",
                "Although SSL pinning has been implemented, the protection can be bypassed using publicly available runtime instrumentation frameworks. As a result, an attacker with control of a rooted device may intercept and inspect HTTPS communications between the application and backend services, potentially exposing sensitive information transmitted over encrypted channels."
              ]
            },
            {
              "row_number": 5,
              "cells": [
                "RETEST STATUS",
                ""
              ]
            },
            {
              "row_number": 6,
              "cells": [
                "Affected User Roles",
                "No authentication required"
              ]
            },
            {
              "row_number": 7,
              "cells": [
                "CVSS SCORE",
                "6.5 (CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:N)"
              ]
            }
          ]
        },
        {
          "block_number": 307,
          "block_type": "paragraph",
          "paragraph_number": 284,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 308,
          "block_type": "paragraph",
          "paragraph_number": 285,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 309,
          "block_type": "paragraph",
          "paragraph_number": 286,
          "table_number": null,
          "style": "Normal",
          "text": "Observation",
          "rows": null
        },
        {
          "block_number": 310,
          "block_type": "paragraph",
          "paragraph_number": 287,
          "table_number": null,
          "style": "Normal",
          "text": "he Android application was assessed to verify the effectiveness of its SSL pinning implementation.",
          "rows": null
        },
        {
          "block_number": 311,
          "block_type": "paragraph",
          "paragraph_number": 288,
          "table_number": null,
          "style": "Normal",
          "text": "During testing, the application correctly rejected connections through an interception proxy when no bypass techniques were applied, indicating that SSL pinning is implemented.",
          "rows": null
        },
        {
          "block_number": 312,
          "block_type": "paragraph",
          "paragraph_number": 289,
          "table_number": null,
          "style": "Normal",
          "text": "However, after attaching a runtime instrumentation framework (e.g., Frida) and applying a standard SSL pinning bypass script, the application established HTTPS connections successfully through the interception proxy. Network traffic could then be decrypted and inspected without additional resistance from the application.",
          "rows": null
        },
        {
          "block_number": 313,
          "block_type": "paragraph",
          "paragraph_number": 290,
          "table_number": null,
          "style": "Normal",
          "text": "This indicates that the current SSL pinning implementation can be bypassed through runtime instrumentation and does not provide sufficient protection against dynamic analysis on compromised devices.",
          "rows": null
        },
        {
          "block_number": 314,
          "block_type": "paragraph",
          "paragraph_number": 291,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 315,
          "block_type": "paragraph",
          "paragraph_number": 292,
          "table_number": null,
          "style": "Normal",
          "text": "Exploitation",
          "rows": null
        },
        {
          "block_number": 316,
          "block_type": "paragraph",
          "paragraph_number": 293,
          "table_number": null,
          "style": "Normal",
          "text": "Configure an interception proxy (e.g., Burp Suite) and install the proxy's CA certificate on a rooted Android device. Then launch the application without any runtime instrumentation and observe that HTTPS communications cannot be intercepted because SSL pinning is enforced.",
          "rows": null
        },
        {
          "block_number": 317,
          "block_type": "paragraph",
          "paragraph_number": 294,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 318,
          "block_type": "paragraph",
          "paragraph_number": 295,
          "table_number": null,
          "style": "Normal",
          "text": "Next, attach Frida to the running application and load a publicly available SSL pinning bypass script.",
          "rows": null
        },
        {
          "block_number": 319,
          "block_type": "paragraph",
          "paragraph_number": 296,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 320,
          "block_type": "paragraph",
          "paragraph_number": 297,
          "table_number": null,
          "style": "Normal",
          "text": "Repeat the previous actions and observe that HTTPS requests and responses can now be successfully intercepted and decrypted through the proxy, confirming that the SSL pinning implementation can be bypassed using runtime instrumentation.",
          "rows": null
        },
        {
          "block_number": 321,
          "block_type": "paragraph",
          "paragraph_number": 298,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 322,
          "block_type": "paragraph",
          "paragraph_number": 299,
          "table_number": null,
          "style": "Normal",
          "text": "Recommendation:",
          "rows": null
        },
        {
          "block_number": 323,
          "block_type": "paragraph",
          "paragraph_number": 300,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 324,
          "block_type": "paragraph",
          "paragraph_number": 301,
          "table_number": null,
          "style": "Normal",
          "text": "Implement SSL Pinning to ensure the application only trusts the specific certificate chain of your backend server",
          "rows": null
        },
        {
          "block_number": 325,
          "block_type": "paragraph",
          "paragraph_number": 302,
          "table_number": null,
          "style": "Normal",
          "text": "For Android:",
          "rows": null
        },
        {
          "block_number": 326,
          "block_type": "paragraph",
          "paragraph_number": 303,
          "table_number": null,
          "style": "List Paragraph",
          "text": "Network Security Configuration: Use the native XML configuration file (res/xml/network_security_config.xml) to define the pin set (hashes of the public keys or certificates)",
          "rows": null
        },
        {
          "block_number": 327,
          "block_type": "paragraph",
          "paragraph_number": 304,
          "table_number": null,
          "style": "List Paragraph",
          "text": "OkHttp: If using OkHttp directly, use the CertificatePinner builder",
          "rows": null
        },
        {
          "block_number": 328,
          "block_type": "paragraph",
          "paragraph_number": 305,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        },
        {
          "block_number": 329,
          "block_type": "paragraph",
          "paragraph_number": 306,
          "table_number": null,
          "style": "Normal",
          "text": "Re-Test Verification Result:",
          "rows": null
        },
        {
          "block_number": 330,
          "block_type": "paragraph",
          "paragraph_number": 307,
          "table_number": null,
          "style": "Normal",
          "text": "",
          "rows": null
        }
      ]
