      "cwe": {
        "reported_value": "CWE-327: Use of a Broken or Risky Cryptographic Algorithm",
        "cwe_id": "CWE-327",
        "description": "Use of a Broken or Risky Cryptographic Algorithm",
        "parse_successful": true
      },
      "impact": {
        "reported_value": "The application uses the HS256 algorithm to sign JSON Web Tokens (JWTs). Unlike asymmetric algorithms, HS256 relies on a single shared secret for both token signing and verification. If the shared signing key is weak, exposed, reused across multiple environments, or otherwise compromised, an attacker may be able to forge valid JWTs and impersonate legitimate users. Although no evidence of such compromise was identified during the assessment, the use of a symmetric signing algorithm increases the reliance on secure key management and should be carefully controlled throughout the application's lifecycle.",
        "is_marked_potential": false
      },
