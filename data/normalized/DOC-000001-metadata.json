        }
      ],
      "cwe": {
        "reported_value": "CWE-798: Use of Hard-coded Credentials",
        "cwe_id": "CWE-798",
        "description": "Use of Hard-coded Credentials",
        "parse_successful": true
      },
      "impact": {
        "reported_value": "The mobile application contains valid RabbitMQ credentials that allow direct authentication to the backend messaging infrastructure. Successful exploitation enables an attacker to access the RabbitMQ broker without requiring prior authentication to the application. Depending on the permissions assigned to the exposed account, an attacker may enumerate messaging resources, publish or consume messages, manipulate business workflows, and potentially compromise the confidentiality, integrity, and availability of the application's messaging infrastructure.",
        "is_marked_potential": false
      },
